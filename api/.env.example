# Copy to api/.env for the native dev flow (make api / make worker / make beat / make test).
# Assumes postgres + redis are reachable on localhost via `make dev-up`.

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://coldreach:coldreach@localhost:5432/coldreach
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

CREDENTIALS_ENCRYPTION_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=

HUNTER_API_KEY=
APOLLO_API_KEY=

DEFAULT_DAILY_SEND_CAP=40
ABSOLUTE_DAILY_SEND_CAP_CEILING=150

# Google Cloud OAuth client (Web application), for the "Connect Gmail" flow.
# Redirect URI must be http://localhost:8000/sending-accounts/oauth/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/sending-accounts/oauth/gmail/callback

WEB_ORIGIN=http://localhost:3000
