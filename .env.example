# Copy to .env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# --- Database (used by api/worker/beat; docker-compose overrides host to `postgres`) ---
DATABASE_URL=postgresql+asyncpg://coldreach:coldreach@localhost:5432/coldreach
POSTGRES_USER=coldreach
POSTGRES_PASSWORD=coldreach
POSTGRES_DB=coldreach

# --- Redis / Celery (docker-compose overrides host to `redis`) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (single operator) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# --- Encryption for credentials at rest ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- LLM (Phase 4) ---
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Enrichment (Phase 8) ---
HUNTER_API_KEY=
APOLLO_API_KEY=

# --- Sending caps ---
DEFAULT_DAILY_SEND_CAP=40
ABSOLUTE_DAILY_SEND_CAP_CEILING=150

# --- Web ---
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
